# 阿里云百炼 OpenAI 兼容接口
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.5-plus

# Tavily 搜索工具
TAVILY_API_KEY=your_tavily_api_key

# 限流（本服务无登录，公开部署时必须靠限流保护 API key 额度；填 0 表示不限）
# 每 IP 每分钟最多请求次数（防突发刷接口）
RATE_LIMIT_PER_MINUTE=10
# 每 IP 每日最多「生成」次数（单访客成本上限）
DAILY_LIMIT_PER_IP=20
# 所有访客合计每日「生成」次数上限（即使伪造 X-Forwarded-For 也烧不穿）
DAILY_LIMIT_TOTAL=200
